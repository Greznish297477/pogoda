<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"/>
    <LinearLayout android:id="@+id/pad" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
        <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="44sp"
                android:fontFamily="sans-serif-light" android:includeFontPadding="false"/>
            <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format24Hour="EEE, d MMMM" android:format12Hour="EEE, d MMMM" android:textColor="#FFFFFF" android:textSize="14sp"/>
<TextView android:id="@+id/temp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<TextView android:id="@+id/desc" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<TextView android:id="@+id/city" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<TextView android:id="@+id/f0" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<TextView android:id="@+id/f1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<TextView android:id="@+id/f2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<TextView android:id="@+id/f3" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<TextView android:id="@+id/f4" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    </LinearLayout>
<ImageView android:id="@+id/div" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<ImageView android:id="@+id/strip" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
</FrameLayout>
